{
  "name": "dwt-toolkit",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "dwt:build": "tsx packages/build/src/cli.ts build",
    "dwt:check": "tsx packages/build/src/cli.ts check",
    "dwt:debug": "tsx packages/debugger/src/cli.ts",
    "dwt:report": "tsx packages/debugger/src/report-cli.ts",
    "dwt:scaffold": "tsx packages/scaffold/src/cli.ts",
    "dwt:calibrate": "tsx packages/smoke/src/calibrate.ts",
    "debugger:build": "tsx packages/debugger/build.ts",
    "build:dist": "pnpm --filter @workflow-toolbox/runtime --filter @workflow-toolbox/patterns --filter @workflow-toolbox/build run build",
    "smoke": "tsx packages/smoke/src/run.ts",
    "canary": "tsx packages/smoke/src/canary-all.ts",
    "canary:edge": "tsx packages/smoke/src/edge-canaries.ts",
    "canary:version": "tsx packages/smoke/src/check-version.ts"
  },
  "devDependencies": {
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.2"
    }
  }
}
