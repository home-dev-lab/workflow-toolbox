{
  "name": "@workflow-toolbox/build",
  "version": "0.1.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/home-dev-lab/workflow-toolbox.git",
    "directory": "toolkit/packages/build"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./define": {
      "import": "./src/define-workflow.ts",
      "types": "./src/define-workflow.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "dwt": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./define": {
        "types": "./dist/define-workflow.d.ts",
        "import": "./dist/define-workflow.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dwt": "tsx src/cli.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@workflow-toolbox/runtime": "workspace:*",
    "esbuild": "~0.25.12"
  },
  "devDependencies": {
    "@workflow-toolbox/patterns": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
