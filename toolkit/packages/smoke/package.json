{
  "name": "@workflow-toolbox/smoke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Headless upgrade-canary smoke test: launches committed toolkit artifacts through the real Workflow runtime via the TS Agent SDK. Not part of `pnpm test`.",
  "exports": {
    "./runtimes": {
      "import": "./src/runtimes.ts",
      "types": "./src/runtimes.ts"
    },
    "./least-privilege": {
      "import": "./src/least-privilege.ts",
      "types": "./src/least-privilege.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workflow-toolbox/build": "workspace:*",
    "@workflow-toolbox/patterns": "workspace:*",
    "@workflow-toolbox/std": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.205",
    "@workflow-toolbox/runtime": "workspace:*",
    "json-schema-to-ts": "^3.1.1",
    "typescript": "^5.5.0"
  }
}
