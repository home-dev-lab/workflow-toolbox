{
  "$comment": "What workflow-toolbox consumes from the Claude Code harness and the Agent SDK, so a docs/changelog digest can be diffed against it (brief to magic-claude-docs, 2026-09-05). Inventoried by a read-only agent over plugin/, toolkit/packages and workflow-observatory/apps/observe-ui/server; entries carrying `where` were read at that path, the others at file-set granularity. Common shape agreed with claude-mem (room 'Fred to All Sessions' #171-#172).",
  "plugin": "workflow-toolbox",
  "version": "0.171.0",
  "measuredAt": "2026-09-05",
  "frontmatter": {
    "manifest": [
      { "name": "userConfig", "where": "plugin/.claude-plugin/plugin.json" }
    ],
    "agents": [
      { "name": "name", "where": "plugin/agents/opencode-envelope.md" },
      { "name": "description", "where": "plugin/agents/leaf-readonly.md" },
      { "name": "tools", "where": "plugin/agents/fidelity-checker.md" },
      { "name": "disallowedTools", "where": "plugin/agents/leaf.md" },
      { "name": "effort", "where": "plugin/agents/opencode-envelope.md" },
      { "name": "model", "where": "plugin/agents/opencode-verifier.md" },
      { "name": "maxTurns", "where": "plugin/agents/opencode-envelope.md" },
      { "name": "memory", "where": "plugin/agent-templates/pilot.md" },
      { "name": "observer", "where": "plugin/agent-templates/pilot.md" },
      { "name": "observerMessage", "where": "plugin/agent-templates/pilot.md" }
    ],
    "skills": [
      { "name": "name", "where": "plugin/skills/adopt/SKILL.md" },
      { "name": "description", "where": "plugin/skills/adopt/SKILL.md" },
      { "name": "user-invocable", "where": "plugin/skills/delegation-chain/SKILL.md" },
      { "name": "argument-hint", "where": "plugin/skills/workflow-debugger/SKILL.md" }
    ]
  },
  "hooks": {
    "events": { "PreToolUse": 24, "PostToolUse": 9, "SessionStart": 8, "UserPromptSubmit": 1, "SubagentStop": 1, "Stop": 5 },
    "types": ["command"],
    "matchers": ["Bash", "SendMessage", "Edit|Write|MultiEdit", "StructuredOutput", "Agent", "Workflow", "*", "SendMessage|Agent|Task", "mcp__planka__get_board|mcp__planka__find_cards"],
    "payloadFields": ["hook_event_name", "session_id", "tool_name", "tool_input", "transcript_path", "cwd", "agent_id", "agent_type", "stop_hook_active"],
    "outputs": [
      { "name": "hookSpecificOutput.permissionDecision=deny + permissionDecisionReason", "where": "plugin/bin/wt-main-guard-hook.mjs:409-412" },
      { "name": "hookSpecificOutput.additionalContext", "where": "plugin/bin (SessionStart hooks)" },
      { "name": "silent exit 0 (allow)", "where": "plugin/bin/wt-main-guard-hook.mjs:42-45" }
    ]
  },
  "monitors": { "file": "plugin/monitors/monitors.json", "fields": ["name", "command", "description", "when"], "count": 7 },
  "shippedSkills": {
    "count": 16,
    "names": ["adopt", "artifact-server", "changelog", "deep-grounding", "delegation-chain", "external-lane", "independent-analysis", "lesson-harvest", "pilot-wave", "planka-tracking", "stale-card-sweep", "toolkit-scaffold", "upgrade-canary", "what-next", "workflow-composer", "workflow-debugger"]
  },
  "functionHooks": {
    "status": "spike only (worktrees/fh-spike); function modules cannot import Node APIs needed to inspect a staged Git diff",
    "events": ["tool.call"],
    "capabilities": ["$.ui.log", "$.store.get", "$.store.set"]
  },
  "sdk": {
    "package": "@anthropic-ai/claude-agent-sdk",
    "version": "^0.3.260",
    "where": "toolkit/packages/smoke/package.json:26",
    "queryOptions": ["resume", "hooks", "plugins", "settingSources", "permissionMode", "canUseTool", "maxTurns", "env", "cwd"],
    "streamEvents": ["result"],
    "streamEventsNote": "workflow_phase / system.init consumed in the observatory server (not re-verified in this pass)"
  },
  "env": [
    { "name": "CLAUDE_CONFIG_DIR", "where": "plugin/bin/wt-observe.mjs:180" },
    { "name": "CLAUDE_PLUGIN_DATA", "where": "plugin/bin/lib/plugin-data-dir.mjs" },
    { "name": "CLAUDE_PLUGIN_ROOT", "where": "plugin/.claude-plugin/plugin.json (hook commands)" },
    { "name": "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS", "where": "worktrees/fh-spike (spike only)" },
    { "name": "WT_LANE_MODELS", "where": "plugin/bin/lib/plugin-options.mjs (env fallback)" },
    { "name": "WT_LANE_SKILLS", "where": "plugin/bin/lib/plugin-options.mjs (env fallback)" },
    { "name": "WT_ARTIFACT_SERVER", "where": "plugin/bin/lib/plugin-options.mjs (env fallback; 0 disables the default-on monitor)" },
    { "name": "WT_ARTIFACT_SERVER_PORT", "where": "plugin/bin/lib/plugin-options.mjs (env fallback)" },
    { "name": "WT_ARTIFACT_SERVER_ROOTS", "where": "plugin/bin/lib/plugin-options.mjs (path-delimited env fallback)" },
    { "name": "WT_ARTIFACT_SERVER_IDLE_GRACE_S", "where": "plugin/bin/lib/plugin-options.mjs (env fallback)" },
    { "name": "WT_ARTIFACT_SERVER_DENY", "where": "plugin/bin/lib/plugin-options.mjs (env fallback)" },
    { "name": "WT_ARTIFACT_SERVER_REGISTRATION_POLL_MS", "where": "plugin/bin/wt-artifact-server.mjs (test-only env knob)" },
    { "name": "WT_ARTIFACT_SERVER_ALLOW_UNSAFE_DENYLIST", "where": "plugin/bin/lib/artifact-server.mjs (test/internal env-only explicit default-deny replacement)" },
    { "name": "WT_VERSION_GUARD_MODE", "where": "plugin/bin/lib/plugin-version-alignment.mjs (align is opt-in; refuse is default)" },
    { "name": "WT_GUARD_JOURNAL_DIR", "where": "plugin/bin/lib/guard-journal.mjs and gate-evidence.mjs (test state-root override)" },
    { "name": "WT_ENVELOPE_WORKDIR", "where": "plugin/bin/wt-opencode-envelope.mjs (per-invocation envelope artifact directory override)" },
    { "name": "WT_QUOTA_PROXY_ORIGINS", "where": "plugin/bin/lib/quota-route.mjs (comma-separated trusted CLI Proxy origins)" },
    { "name": "WT_FINDINGS_DISPOSITION_MODE", "where": "plugin/bin/wt-report-findings-check.mjs (block override for the Findings disposition probation)" },
    { "name": "WT_FINDINGS_DISPOSITION_NOW", "where": "plugin/bin/wt-report-findings-check.mjs (deterministic clock override)" }
  ],
  "cli": [
    { "name": "node plugin/bin/wt-artifact-server.mjs url|status|stop|restart", "where": "plugin/skills/artifact-server/SKILL.md" },
    { "name": "node <configDir>/scripts/wt-lane.mjs", "where": "README.md and plugin/skills/external-lane/SKILL.md" },
    { "name": "node plugin/bin/wt-plugin-eval-gate.mjs", "where": "docs/public/known-issues.md" },
    { "name": "claude plugin validate", "where": "README.md" },
    { "name": "claude --plugin-dir / --debug-file / --allowedTools / -p", "where": "worktrees/fh-spike (spike only)" },
    { "name": "/plugin-types", "where": "worktrees/fh-spike/types (spike only)" },
    { "name": "node plugin/bin/wt-report-findings-check.mjs", "where": "plugin/agent-templates/pilot-orchestrator.md and plugin/skills/lesson-harvest/SKILL.md" }
  ],
  "invariants": [
    "CLAUDE_PLUGIN_ROOT is EMPTY in the main session's Bash shell; only hook commands see it",
    "CLAUDE_PLUGIN_DATA in the main shell names ANOTHER plugin's dir; never read it outside a plugin process",
    "a tools: allow-list can deliver fewer tools than declared; read the running agent's surface",
    "PostToolUse command hooks receive the RAW tool output, before any function-hook rewrite",
    "SubagentStop block is honoured only on the model-stop path",
    "isolated worktrees for spawned agents start from the repo DEFAULT branch",
    ".wt-gates.json declares commit-time gates and paths; records are valid only for their exact tree signature"
  ]
}
